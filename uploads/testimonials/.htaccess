# Quran & Science — Upload Directory Security (Testimonials)
# Hardened for Apache, LiteSpeed, and PHP-FPM environments

# Disable directory listing and script execution
Options -Indexes -ExecCGI

# Deny all executable script and sensitive extensions
<FilesMatch "(?i)\.(php|php3|php4|php5|php7|php8|phtml|phar|phps|cgi|pl|py|sh|asp|aspx|shtml|env|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow public read access to approved image formats only
<FilesMatch "(?i)\.(jpg|jpeg|png|webp)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
</FilesMatch>

# Safely remove executable handlers without relying on php_flag (compatible with PHP-FPM / LiteSpeed)
<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh
</IfModule>
